{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/UC-San-Diego-DIA/DIA-Harness-Skills/blob/main/docs/shared/workbook-facts.schema.json",
  "title": "workbook-facts.yaml (schema version 2)",
  "description": "Deterministic facts extracted from one Tableau workbook package or workbook XML document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "workbook",
    "extraction",
    "completeness",
    "anomalies",
    "interpretation_inputs",
    "datasources",
    "parameters",
    "dashboards",
    "worksheets",
    "derived"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "field_metadata_version": {
      "const": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "tool_version",
        "input_file",
        "input_sha256",
        "container",
        "entry",
        "extracted_at",
        "schema_url"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_sha256_reason": {
          "type": "string"
        },
        "container": {
          "type": "string",
          "enum": [
            "twbx",
            "twb"
          ]
        },
        "entry": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string",
          "minLength": 1
        },
        "schema_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tableau_version",
        "source_build",
        "source_platform",
        "repository_location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "tableau_version": {
          "type": "string"
        },
        "source_build": {
          "type": "string"
        },
        "source_platform": {
          "type": "string"
        },
        "repository_location": {
          "type": "string"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "entry",
        "timestamp",
        "warnings"
      ],
      "properties": {
        "container": {
          "type": "string",
          "enum": [
            "twbx",
            "twb"
          ]
        },
        "entry": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "datasources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "caption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/field"
            }
          },
          "field_inventory": {
            "$ref": "#/$defs/field_inventory"
          },
          "model_structure": {
            "$ref": "#/$defs/model_structure"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "datasource",
          "name",
          "caption",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "datasource": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "dashboards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "datasources",
          "size",
          "title_text",
          "sheets",
          "layout",
          "filters",
          "legends",
          "parameter_controls",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "datasources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "title_text": {
            "type": "string"
          },
          "sheets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "sheet",
                    "filter",
                    "legend",
                    "parameter",
                    "title",
                    "text",
                    "image",
                    "web",
                    "other"
                  ]
                }
              }
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "source_sheet",
                "field"
              ],
              "properties": {
                "kind": {
                  "const": "filter"
                }
              }
            }
          },
          "legends": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "legend_kind",
                "source_sheet",
                "field"
              ],
              "properties": {
                "kind": {
                  "const": "legend"
                },
                "legend_kind": {
                  "type": "string",
                  "enum": [
                    "color",
                    "size",
                    "shape"
                  ]
                }
              }
            }
          },
          "parameter_controls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "parameter",
                "caption"
              ],
              "properties": {
                "kind": {
                  "const": "parameter"
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "source_sheet"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "source_sheet": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "worksheets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "title_text",
          "datasources",
          "rows",
          "cols",
          "calculations",
          "filters",
          "mark_types",
          "encodings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title_text": {
            "type": "string"
          },
          "datasources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calculations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "caption",
                "kind",
                "formula"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "formula": {
                  "type": "string"
                }
              }
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "column",
                "class"
              ],
              "properties": {
                "column": {
                  "type": "string"
                },
                "class": {
                  "type": "string"
                },
                "column_caption": {
                  "type": "string"
                }
              }
            }
          },
          "mark_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "encodings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attr",
                "field"
              ],
              "properties": {
                "attr": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "field_caption": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheets_on_dashboards",
        "orphan_sheets",
        "duplicate_name_groups"
      ],
      "properties": {
        "sheets_on_dashboards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphan_sheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_name_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base",
              "sheets"
            ],
            "properties": {
              "base": {
                "type": "string"
              },
              "sheets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              }
            }
          }
        }
      }
    },
    "completeness": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/completeness_record"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anomaly_record"
      }
    },
    "interpretation_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard_purposes",
        "sheet_roles"
      ],
      "properties": {
        "dashboard_purposes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dashboard_purpose_record"
          }
        },
        "sheet_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sheet_role_record"
          }
        }
      }
    },
    "model_metadata_version": {
      "const": 1
    }
  },
  "$defs": {
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "caption",
        "datatype",
        "role",
        "type",
        "hidden",
        "default_aggregation",
        "description",
        "calculation",
        "field_kind",
        "aliases",
        "source_columns",
        "evidence",
        "conflicts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "$ref": "#/$defs/nullable_string"
        },
        "datatype": {
          "$ref": "#/$defs/nullable_string"
        },
        "role": {
          "$ref": "#/$defs/nullable_string"
        },
        "type": {
          "$ref": "#/$defs/nullable_string"
        },
        "hidden": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "default_aggregation": {
          "$ref": "#/$defs/nullable_string"
        },
        "description": {
          "$ref": "#/$defs/nullable_string"
        },
        "field_kind": {
          "enum": [
            "source",
            "calculated"
          ]
        },
        "calculation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "class",
                "formula"
              ],
              "properties": {
                "class": {
                  "$ref": "#/$defs/nullable_string"
                },
                "formula": {
                  "$ref": "#/$defs/nullable_string"
                }
              }
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/nullable_string"
              },
              "value": {
                "$ref": "#/$defs/nullable_string"
              }
            }
          }
        },
        "source_columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "table",
              "name",
              "datatype"
            ],
            "properties": {
              "table": {
                "$ref": "#/$defs/nullable_string"
              },
              "name": {
                "$ref": "#/$defs/nullable_string"
              },
              "datatype": {
                "$ref": "#/$defs/nullable_string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attribute",
              "evidence"
            ],
            "properties": {
              "attribute": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "field_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "field_count",
        "skipped_records",
        "conflicting_fields",
        "warnings"
      ],
      "properties": {
        "scope": {
          "enum": [
            "workbook_datasource",
            "worksheet_dependencies_only"
          ]
        },
        "field_count": {
          "type": "integer"
        },
        "skipped_records": {
          "type": "integer"
        },
        "conflicting_fields": {
          "type": "integer"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "completeness_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "expected",
        "found",
        "skipped",
        "out_of_scope",
        "status"
      ],
      "properties": {
        "section": {
          "type": "string",
          "enum": [
            "dashboards",
            "worksheets",
            "parameters",
            "datasources"
          ]
        },
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "found": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_scope": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "out_of_scope"
          ]
        },
        "reason_code": {
          "type": "string"
        }
      }
    },
    "anomaly_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "rule_version",
        "affected_ids",
        "evidence",
        "count",
        "status"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "EMPTY_ZONE",
            "DUPLICATE_SHEET_NAME",
            "ORPHAN_SHEET",
            "ID_COLLISION",
            "UNRECOGNIZED_ZONE",
            "MULTIPLE_TWB_ENTRIES",
            "STORY_NOT_INVENTORIED",
            "UNCLASSIFIED_WARNING"
          ]
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "not_found",
            "out_of_scope"
          ]
        }
      }
    },
    "dashboard_purpose_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard_id",
        "purpose",
        "confirmed_at",
        "supporting_fact_id"
      ],
      "properties": {
        "dashboard_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1
        },
        "supporting_fact_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sheet_role_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheet_id",
        "role",
        "confirmed_at",
        "supporting_fact_id"
      ],
      "properties": {
        "sheet_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "kpi_card",
            "trend_chart",
            "breakdown_chart",
            "distribution_chart",
            "table",
            "text_annotation",
            "data_date_stamp",
            "map",
            "filter_panel",
            "other"
          ]
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1
        },
        "supporting_fact_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model_xml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "attributes",
        "text",
        "children"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_xml"
          }
        }
      }
    },
    "model_logical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object_id",
        "caption",
        "relation_ids",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logical_table_id",
        "parent_relation_id",
        "context",
        "type",
        "name",
        "table",
        "connection",
        "join_type",
        "attributes",
        "clauses",
        "text",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "logical_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_relation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "connection": {
          "type": [
            "string",
            "null"
          ]
        },
        "join_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clauses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_xml"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "object_id",
        "logical_table_id",
        "configured_settings",
        "evidence"
      ],
      "properties": {
        "side": {
          "enum": [
            "first-end-point",
            "second-end-point"
          ]
        },
        "object_id": {
          "type": [
            "string",
