{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Hyper extract value observations, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "provenance",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "tableau_value_profile"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workbook_sha256",
        "extract_entry",
        "extract_sha256"
      ],
      "properties": {
        "workbook_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "extract_entry": {
          "type": "string",
          "minLength": 1
        },
        "extract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "name",
          "row_count",
          "fields"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "datatype",
                "null_count",
                "distinct_count",
                "values",
                "values_truncated"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "datatype": {
                  "type": "string",
                  "minLength": 1
                },
                "null_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "distinct_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "values": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "count"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "values_truncated": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
