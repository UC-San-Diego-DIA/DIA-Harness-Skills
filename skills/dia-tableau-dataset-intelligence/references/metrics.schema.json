{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "dataset_id",
    "source_workbook_sha256",
    "status",
    "reviewed",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "metric_proposals"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "source_workbook_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "draft"
    },
    "reviewed": {
      "type": "boolean"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "origin",
          "support",
          "support_rationale",
          "field_refs",
          "glossary_refs",
          "assumptions",
          "approval_gates",
          "approval",
          "data_verification",
          "name",
          "description",
          "formula",
          "date",
          "dimension_refs",
          "filters",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "approved"
            ]
          },
          "origin": {
            "const": "schema_proposed"
          },
          "support": {
            "enum": [
              "supported",
              "conditional",
              "unsupported"
            ]
          },
          "support_rationale": {
            "type": "string",
            "minLength": 1
          },
          "field_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "glossary_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "approval_gates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "requirement",
                "resolved",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "resolved": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "minItems": 0
          },
          "approval": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by",
                  "at",
                  "evidence"
                ],
                "properties": {
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "data_verification": {
            "const": "not_tested"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expression",
              "bindings",
              "aggregation",
              "grain_ref",
              "grain_statement"
            ],
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "symbol",
                    "field_id"
                  ],
                  "properties": {
                    "symbol": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "field_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "aggregation": {
                "enum": [
                  "sum",
                  "count",
                  "count_distinct",
                  "average",
                  "ratio",
                  "custom"
                ]
              },
              "grain_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "grain_statement": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "date": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_ref",
              "basis",
              "period",
              "timezone"
            ],
            "properties": {
              "field_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "dimension_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field_ref",
                "operator",
                "value",
                "rationale"
              ],
              "properties": {
                "field_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "enum": [
                    "equals",
                    "not_equals",
                    "in",
                    "not_in",
                    "is_null",
                    "is_not_null",
                    "range",
                    "requires_definition"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 0
          },
          "unit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "basis"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 0
    }
  }
}
