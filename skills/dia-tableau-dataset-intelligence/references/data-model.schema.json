{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset model component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "dataset_id",
    "source_workbook_sha256",
    "status",
    "reviewed",
    "structural_snapshot",
    "table_meanings",
    "grains",
    "candidate_keys",
    "risks",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "dataset_model"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "source_workbook_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "reviewed": {
      "type": "boolean"
    },
    "structural_snapshot": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datasource_id",
          "model_structure"
        ],
        "properties": {
          "datasource_id": {
            "type": "string",
            "minLength": 1
          },
          "model_structure": {
            "$ref": "#/$defs/model_structure"
          }
        }
      }
    },
    "table_meanings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "table_id",
          "field_ids",
          "statement",
          "status",
          "verification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "field_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed"
            ]
          },
          "verification": {
            "const": "not_tested"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confirmed_by": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "grains": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "table_id",
          "field_ids",
          "statement",
          "status",
          "verification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "field_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed"
            ]
          },
          "verification": {
            "const": "not_tested"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confirmed_by": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate_keys": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "table_id",
          "field_ids",
          "statement",
          "status",
          "verification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "field_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed"
            ]
          },
          "verification": {
            "const": "not_tested"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confirmed_by": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "verification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed"
            ]
          },
          "verification": {
            "const": "not_tested"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confirmed_by": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "model_xml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "attributes",
        "text",
        "children"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_xml"
          }
        }
      }
    },
    "model_logical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object_id",
        "caption",
        "relation_ids",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "logical_table_id",
        "parent_relation_id",
        "context",
        "type",
        "name",
        "table",
        "connection",
        "join_type",
        "attributes",
        "clauses",
        "text",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "logical_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_relation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "connection": {
          "type": [
            "string",
            "null"
          ]
        },
        "join_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "clauses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_xml"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "object_id",
        "logical_table_id",
        "configured_settings",
        "evidence"
      ],
      "properties": {
        "side": {
          "enum": [
            "first-end-point",
            "second-end-point"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "configured_settings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attributes",
        "endpoints",
        "expressions",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_endpoint"
          }
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_xml"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field_id",
        "name",
        "remote_name",
        "parent_name",
        "family",
        "object_id",
        "logical_table_id",
        "source_declared_nullable",
        "cached_contains_null",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "logical_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_declared_nullable": {
          "type": [
            "string",
            "null"
          ]
        },
        "cached_contains_null": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "message",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "logical_tables",
        "relations",
        "relationships",
        "column_metadata",
        "gaps"
      ],
      "properties": {
        "scope": {
          "const": "workbook_metadata_only"
        },
        "logical_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_logical"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_relation"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_relationship"
          }
        },
        "column_metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_column"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model_gap"
          }
        }
      }
    }
  }
}
